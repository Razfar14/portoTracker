# Database Configuration (Local)
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_DATABASE=idx_saas
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DIALECT=postgres

# Database Connection URL (Production / Supabase)
POSTGRES_URL=postgresql://user:password@host:port/database

# JWT Authentication Config
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES=1d

# External News API / RSS Endpoints
RSS_FEED_MARKET=https://www.cnbcindonesia.com/market/rss
RSS_FEED_NEWS=https://www.cnbcindonesia.com/news/rss
RSS_FEED_ANTARA=https://www.antara-news.com/rss/ekonomi
