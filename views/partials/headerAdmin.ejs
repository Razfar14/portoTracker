<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <span class="text-xl font-semibold text-gray-900 tracking-tight">PortfolioTracker <span class="text-blue-600">Admin</span></span>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex space-x-1">
        <a href="/admin" class="px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors">Dashboard</a>
        <a href="/adminViewPortoClient" class="px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors">Porto Client</a>
        <a href="/newsAdmin" class="px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors">News</a>
        <a href="/requstSahamAdmin" class="px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors">Permintaan Saham</a>
      </nav>

      <!-- User Info & Logout (Desktop) -->
      <div class="hidden md:flex items-center gap-4">
        <span id="user-email-desktop" class="text-sm text-gray-700 font-medium"></span>
        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-700/10">ADMIN</span>
        <button onclick="logout()" class="text-sm font-medium text-gray-600 hover:text-gray-900 border border-gray-300 px-3 py-1.5 rounded-md hover:bg-gray-50 transition-colors shadow-sm">
          Logout
        </button>
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center md:hidden">
        <button type="button" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')" class="inline-flex items-center justify-center p-2 rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500 transition-colors">
          <span class="sr-only">Open main menu</span>
          <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="md:hidden hidden bg-white border-t border-gray-100 shadow-lg absolute w-full" id="mobile-menu">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      <a href="/admin" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50 transition-colors">Dashboard</a>
      <a href="/adminViewPortoClient" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50 transition-colors">Porto Client</a>
      <a href="/newsAdmin" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50 transition-colors">News</a>
      <a href="/requstSahamAdmin" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50 transition-colors">Permintaan Saham</a>
    </div>
    <div class="pt-4 pb-4 border-t border-gray-200 bg-gray-50">
      <div class="flex items-center px-5 gap-3">
        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700">ADMIN</span>
        <div class="text-base font-medium text-gray-800" id="user-email-mobile">Admin User</div>
      </div>
      <div class="mt-4 px-5">
        <button onclick="logout()" class="w-full flex justify-center py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
          Logout
        </button>
      </div>
    </div>
  </div>

  <script>
    (function() {
      const uInfo = JSON.parse(localStorage.getItem('portfolio_user') || 'null');
      if(uInfo) {
        const desktopEl = document.getElementById('user-email-desktop');
        if(desktopEl) desktopEl.innerText = uInfo.username;
        const mobileEl = document.getElementById('user-email-mobile');
        if(mobileEl) mobileEl.innerText = uInfo.username;
      }
    })();
  </script>
</header>