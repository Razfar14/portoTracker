<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Portfolio Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="h-full text-gray-800 font-sans antialiased flex flex-col">

  <%- include('partials/headerAdmin') %>

  <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex justify-center">
    <div class="w-full space-y-8">
      <h2 class="text-2xl font-bold text-gray-900">Admin Dashboard</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Add Stock Form -->
        <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Add Stock Purchase</h3>
          <form onsubmit="addStock(event)" class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700">User ID (Client)</label>
              <input type="number" id="stock-userid" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700">Ticker Symbol (e.g. BBCA)</label>
              <input type="text" id="stock-ticker" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm uppercase">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700">Buy Price</label>
              <input type="number" id="stock-price" step="0.01" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700">Quantity (Lots/Shares)</label>
              <input type="number" id="stock-quantity" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            </div>
            <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">Save Purchase</button>
          </form>
        </div>

        <!-- Add Deposit Form -->
        <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Add Deposit/Fund Transfer</h3>
          <form onsubmit="addDeposit(event)" class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700">User ID (Client)</label>
              <input type="number" id="dep-userid" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700">Amount (IDR)</label>
              <input type="number" id="dep-amount" step="0.01" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700">Notes (Optional)</label>
              <input type="text" id="dep-notes" placeholder="e.g. Transfer via BCA" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            </div>
            <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700">Save Deposit</button>
          </form>
        </div>
      </div>
    </div>
  </main>

  <script>
    const API_BASE = window.location.origin;
    let jwtToken = localStorage.getItem('portfolio_token');
    let currentUser = JSON.parse(localStorage.getItem('portfolio_user') || 'null');

    window.onload = () => {
      if (!jwtToken || !currentUser || currentUser.role !== 'admin') {
        window.location.href = '/'; // redirect to login
        return;
      }
      document.getElementById('user-email').innerText = currentUser.username;
    };

    function logout() {
      localStorage.removeItem('portfolio_token');
      localStorage.removeItem('portfolio_user');
      window.location.href = '/';
    }

    async function addStock(e) {
      e.preventDefault();
      const payload = {
        user_id: document.getElementById('stock-userid').value,
        ticker: document.getElementById('stock-ticker').value,
        buy_price: document.getElementById('stock-price').value,
        quantity: document.getElementById('stock-quantity').value
      };
      
      try {
        const res = await fetch(API_BASE + '/api/portfolio', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${jwtToken}`
          },
          body: JSON.stringify(payload)
        });
        if (res.ok) {
          alert('Stock purchase saved!');
          e.target.reset();
        } else {
          const data = await res.json();
          alert('Error: ' + data.message);
        }
      } catch (err) {
        alert('Error saving stock');
      }
    }

    async function addDeposit(e) {
      e.preventDefault();
      const payload = {
        user_id: document.getElementById('dep-userid').value,
        amount: document.getElementById('dep-amount').value,
        notes: document.getElementById('dep-notes').value
      };
      
      try {
        const res = await fetch(API_BASE + '/api/deposits', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${jwtToken}`
          },
          body: JSON.stringify(payload)
        });
        if (res.ok) {
          alert('Deposit saved!');
          e.target.reset();
        } else {
          const data = await res.json();
          alert('Error: ' + data.message);
        }
      } catch (err) {
        alert('Error saving deposit');
      }
    }
  </script>
</body>
</html>

