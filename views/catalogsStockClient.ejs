<!DOCTYPE html>
<html lang="id" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Katalog Saham Realtime - Bursa Efek Indonesia (IDX)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://s3.tradingview.com/tv.js"></script>
</head>
<body class="h-full text-gray-800 font-sans antialiased flex flex-col">

  <%- include('partials/headerClient') %>

  <!-- Konten Utama -->
  <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="w-full space-y-8">
      
      <!-- Banner Header Halaman & Pencarian -->
      <div class="bg-gradient-to-r from-emerald-900 via-teal-900 to-slate-900 rounded-2xl p-6 sm:p-8 text-white shadow-md relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 opacity-10 pointer-events-none">
          <svg class="w-80 h-80 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/></svg>
        </div>

        <div class="relative z-10 max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Data Bursa Efek Indonesia (IDX) Realtime & Terupdate Otomatis
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Katalog Saham & Emiten IDX</h1>
          <p class="text-emerald-100 text-sm sm:text-base leading-relaxed">
            Pantau pergerakan harga pasar saham secara langsung (realtime), persentase naik/turun hari ini, sektor bisnis, grafik teknikal TradingView, serta analisa rasio valuasi fundamental perusahaan.
          </p>

          <!-- Input Pencarian & Pengurutan -->
          <div class="pt-2 flex flex-col sm:flex-row gap-3">
            <div class="relative flex-grow">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              </div>
              <input type="text" id="stock-search-input" oninput="handleSearchDebounced()" placeholder="Cari kode ticker atau nama perusahaan (contoh: BBCA, Adaro, Telkom, GoTo)..." class="w-full pl-10 pr-4 py-3 bg-white text-gray-900 rounded-xl text-sm font-medium focus:ring-2 focus:ring-emerald-400 focus:outline-none shadow-sm">
            </div>

            <select id="stock-sort-select" onchange="loadStockCatalog()" class="px-4 py-3 bg-white text-gray-900 rounded-xl text-sm font-medium focus:ring-2 focus:ring-emerald-400 focus:outline-none shadow-sm min-w-[200px]">
              <option value="market_cap:DESC">Kapitalisasi Pasar Terbesar</option>
              <option value="last_price:DESC">Harga Tertinggi</option>
              <option value="last_price:ASC">Harga Terendah</option>
              <option value="per:ASC">Valuasi PER Terendah (Termurah)</option>
              <option value="pbv:ASC">Valuasi PBV Terendah</option>
              <option value="dividend_yield:DESC">Dividen Yield Tertinggi</option>
              <option value="roe:DESC">Profitabilitas ROE Tertinggi</option>
              <option value="ticker:ASC">Urutan Abjad (A - Z)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Filter Tombol Sektor Industri -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Pilih Sektor Industri:</span>
          <span id="active-filter-badge" class="text-xs text-gray-500 font-medium">Menampilkan Seluruh Sektor</span>
        </div>
        <div id="sector-chips-container" class="flex flex-wrap gap-2 pt-1">
          <button onclick="selectSector('all')" class="sector-chip active px-4 py-2 rounded-xl text-xs font-semibold transition-all shadow-sm bg-emerald-600 text-white" data-sector="all">
            Semua Sektor
          </button>
          <!-- Tombol chip sektor di-render secara dinamis oleh JS -->
        </div>
      </div>

      <!-- Panduan Singkat Arti Istilah Metrik (Edukasi Finansial) -->
      <div class="bg-white p-5 border border-gray-200 rounded-2xl shadow-sm">
        <details class="group cursor-pointer">
          <summary class="flex items-center justify-between text-sm font-bold text-gray-800 list-none">
            <div class="flex items-center gap-2">
              <span class="p-1.5 bg-emerald-50 text-emerald-600 rounded-lg">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </span>
              <span>Panduan Membaca Istilah Rasio Finansial (Market Cap, PER, PBV, ROE, DER)</span>
            </div>
            <span class="text-gray-400 group-open:rotate-180 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </summary>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pt-4 mt-3 border-t border-gray-100 text-xs leading-relaxed text-gray-600">
            <div class="p-3 bg-gray-50 rounded-xl border border-gray-100 space-y-1">
              <span class="font-bold text-gray-900 block">1. Kapitalisasi Pasar (Market Cap)</span>
              <p>Total nilai valuasi keseluruhan saham perusahaan di bursa (Harga Saham &times; Jumlah Lembar Saham Beredar). Menunjukkan seberapa besar ukuran perusahaan tersebut.</p>
            </div>
            <div class="p-3 bg-gray-50 rounded-xl border border-gray-100 space-y-1">
              <span class="font-bold text-indigo-700 block">2. P/E Ratio (Price to Earnings Ratio / PER)</span>
              <p>Rasio harga saham dibandingkan laba bersih per lembar saham. Menunjukkan berapa kali lipat investor bersedia membayar untuk setiap Rp 1 laba yang dihasilkan perusahaan.</p>
            </div>
            <div class="p-3 bg-gray-50 rounded-xl border border-gray-100 space-y-1">
              <span class="font-bold text-blue-700 block">3. PBV Ratio (Price to Book Value)</span>
              <p>Rasio harga saham dibandingkan nilai buku (aset bersih) per lembar saham. Nilai PBV di bawah 1x sering kali dianggap sebagai saham yang dihargai di bawah nilai aset bersihnya.</p>
            </div>
            <div class="p-3 bg-gray-50 rounded-xl border border-gray-100 space-y-1">
              <span class="font-bold text-emerald-700 block">4. Return on Equity (ROE)</span>
              <p>Persentase tingkat pengembalian laba bersih dari total modal/ekuitas yang dimiliki. Mengukur seberapa pintar manajemen perusahaan memutar modal investor menjadi keuntungan.</p>
            </div>
            <div class="p-3 bg-gray-50 rounded-xl border border-gray-100 space-y-1">
              <span class="font-bold text-amber-700 block">5. Debt to Equity Ratio (DER)</span>
              <p>Rasio jumlah total hutang perusahaan dibandingkan dengan total modal/ekuitasnya. Menilai tingkat risiko solvabilitas dan ketergantungan perusahaan pada pinjaman.</p>
            </div>
            <div class="p-3 bg-gray-50 rounded-xl border border-gray-100 space-y-1">
              <span class="font-bold text-teal-700 block">6. Dividend Yield (%)</span>
              <p>Persentase dividen tunai tahunan yang dibagikan kepada pemegang saham dibandingkan dengan harga saham saat ini. Semakin tinggi, semakin besar pendapatan pasif dividen.</p>
            </div>
          </div>
        </details>
      </div>

      <!-- Grid Daftar Kartu Saham -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-gray-900" id="catalog-heading">Daftar Saham Terdaftar</h2>
          <span id="stock-count-badge" class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-semibold">Memuat data...</span>
        </div>

        <div id="stock-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          <div class="col-span-full py-16 text-center text-gray-500 bg-white rounded-2xl border border-gray-200">
            <svg class="w-8 h-8 text-emerald-500 animate-spin mx-auto mb-3" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            <p class="text-sm font-medium">Memuat katalog saham dan data harga realtime bursa...</p>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- Modal Popup Detail Saham & Grafik TradingView Realtime -->
  <div id="stock-detail-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4">
    <div class="bg-white rounded-2xl max-w-4xl w-full max-h-[92vh] overflow-y-auto shadow-2xl border border-gray-100 flex flex-col animate-in fade-in zoom-in-95 duration-150">
      
      <!-- Header Modal -->
      <div class="flex items-start justify-between p-5 sm:p-6 border-b border-gray-100 bg-gray-50/50 sticky top-0 bg-white z-10">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-black text-xl shadow-sm">
            <span id="modal-ticker-icon">BBCA</span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h3 id="modal-ticker" class="text-2xl font-black text-gray-900 tracking-tight">BBCA</h3>
              <span id="modal-sector-badge" class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Sektor Keuangan</span>
            </div>
            <p id="modal-company-name" class="text-sm font-medium text-gray-600">PT Bank Central Asia Tbk</p>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="text-right">
            <div class="text-xs text-gray-500 font-medium">Harga Realtime:</div>
            <div id="modal-price" class="text-2xl font-black text-gray-900">Rp 6.625</div>
            <div id="modal-daily-change-badge" class="text-xs font-bold mt-0.5">Memuat perubahan...</div>
          </div>
          <button onclick="closeStockModal()" class="p-2 text-gray-400 hover:text-gray-600 rounded-lg hover:bg-gray-100 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>

      <!-- Isi Badan Modal -->
      <div class="p-5 sm:p-6 space-y-6 flex-grow">
        
        <!-- Statistik Pergerakan Hari Ini -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-gray-50 p-3.5 rounded-xl border border-gray-100 text-xs">
          <div>
            <span class="text-gray-500 block">Penutupan Sebelumnya:</span>
            <span id="modal-prev-close" class="font-bold text-gray-800 text-sm">Rp 0</span>
          </div>
          <div>
            <span class="text-gray-500 block">Tertinggi Hari Ini (High):</span>
            <span id="modal-day-high" class="font-bold text-emerald-600 text-sm">Rp 0</span>
          </div>
          <div>
            <span class="text-gray-500 block">Terendah Hari Ini (Low):</span>
            <span id="modal-day-low" class="font-bold text-rose-600 text-sm">Rp 0</span>
          </div>
          <div>
            <span class="text-gray-500 block">Perubahan Hari Ini:</span>
            <span id="modal-daily-change-sub" class="font-bold text-sm">0.00%</span>
          </div>
        </div>

        <!-- Wadah Grafik Interaktif TradingView -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <h4 class="text-sm font-bold text-gray-900 uppercase tracking-wider flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg>
              Grafik Pasar Interaktif (TradingView Live Chart)
            </h4>
            <span class="text-xs text-gray-400">Live feed Bursa Efek Indonesia (IDX)</span>
          </div>
          <div id="modal-chart-container" class="w-full h-[360px] sm:h-[400px] border border-gray-200 rounded-xl overflow-hidden bg-gray-50">
            <!-- Widget TradingView di-render di sini -->
          </div>
        </div>

        <!-- Grid Metrik Rasio Finansial & Valuasi -->
        <div class="space-y-3">
          <h4 class="text-sm font-bold text-gray-900 uppercase tracking-wider">Metrik Valuasi & Finansial Fundamental</h4>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="bg-gray-50 p-3.5 rounded-xl border border-gray-100">
              <span class="text-xs text-gray-500 font-medium">Kapitalisasi Pasar</span>
              <div id="modal-market-cap" class="text-base font-extrabold text-gray-900 mt-1">Rp 0</div>
            </div>
            <div class="bg-gray-50 p-3.5 rounded-xl border border-gray-100">
              <span class="text-xs text-gray-500 font-medium">P/E Ratio (PER)</span>
              <div id="modal-per" class="text-base font-extrabold text-indigo-600 mt-1">-</div>
            </div>
            <div class="bg-gray-50 p-3.5 rounded-xl border border-gray-100">
              <span class="text-xs text-gray-500 font-medium">PBV Ratio</span>
              <div id="modal-pbv" class="text-base font-extrabold text-blue-600 mt-1">-</div>
            </div>
            <div class="bg-gray-50 p-3.5 rounded-xl border border-gray-100">
              <span class="text-xs text-gray-500 font-medium">Dividend Yield</span>
              <div id="modal-div-yield" class="text-base font-extrabold text-emerald-600 mt-1">-</div>
            </div>
            <div class="bg-gray-50 p-3.5 rounded-xl border border-gray-100">
              <span class="text-xs text-gray-500 font-medium">Return on Equity (ROE)</span>
              <div id="modal-roe" class="text-base font-extrabold text-gray-900 mt-1">-</div>
            </div>
            <div class="bg-gray-50 p-3.5 rounded-xl border border-gray-100">
              <span class="text-xs text-gray-500 font-medium">Debt to Equity (DER)</span>
              <div id="modal-der" class="text-base font-extrabold text-gray-900 mt-1">-</div>
            </div>
            <div class="bg-gray-50 p-3.5 rounded-xl border border-gray-100">
              <span class="text-xs text-gray-500 font-medium">Pertumbuhan Omset (YoY)</span>
              <div id="modal-rev-growth" class="text-base font-extrabold text-gray-900 mt-1">-</div>
            </div>
            <div class="bg-gray-50 p-3.5 rounded-xl border border-gray-100">
              <span class="text-xs text-gray-500 font-medium">Kode Ticker Bursa</span>
              <div id="modal-ticker-code" class="text-base font-extrabold text-emerald-700 mt-1">IDX:BBCA</div>
            </div>
          </div>
        </div>

        <!-- Profil Perusahaan & Deskripsi Sektor -->
        <div class="bg-emerald-50/60 border border-emerald-100 rounded-xl p-4 space-y-2">
          <div class="flex items-center gap-2">
            <span class="p-1.5 bg-emerald-100 text-emerald-700 rounded-lg">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </span>
            <h5 class="text-sm font-bold text-gray-900">Tentang Sektor & Profil Aktivitas Bisnis</h5>
          </div>
          <p id="modal-sector-desc" class="text-xs sm:text-sm text-gray-700 leading-relaxed">
            Memuat deskripsi sektor...
          </p>
        </div>

      </div>

      <!-- Footer Modal -->
      <div class="p-4 sm:p-5 border-t border-gray-100 bg-gray-50/80 flex items-center justify-between gap-3">
        <button onclick="closeStockModal()" class="px-5 py-2.5 border border-gray-300 rounded-xl text-sm font-medium text-gray-700 bg-white hover:bg-gray-100 transition-colors">
          Tutup
        </button>
        <div id="modal-action-btn-container">
          <a href="/requestSahamClient" class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white rounded-xl text-sm font-semibold shadow-sm transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Ajukan Permintaan Pembelian Saham Ini
          </a>
        </div>
      </div>

    </div>
  </div>

  <script>
    const API_BASE = window.location.origin;
    let allStocks = [];
    let allSectors = [];
    let selectedSector = 'all';
    let searchDebounceTimer = null;

    // Pemetaan nama sektor ke Bahasa Indonesia
    const sectorTranslationMap = {
      'Financials': 'Keuangan & Perbankan',
      'Energy': 'Energi & Tambang',
      'Consumer Non-Cyclicals': 'Barang Konsumen Primer',
      'Basic Materials': 'Material Dasar & Kimia',
      'Healthcare': 'Kesehatan & Farmasi',
      'Infrastructures': 'Infrastruktur & Telko',
      'Consumer Cyclicals': 'Konsumen Non-Primer & Ritel',
      'Properties & Real Estate': 'Properti & Real Estat',
      'Technology': 'Teknologi & Digital',
      'Industrials': 'Perindustrian & Alat Berat',
      'Transportation & Logistics': 'Transportasi & Logistik'
    };

    function translateSector(name) {
      return sectorTranslationMap[name] || name || 'Umum';
    }

    function formatIDR(num) {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(num || 0);
    }

    function formatMarketCap(num) {
      if (!num || isNaN(num)) return '-';
      const n = parseFloat(num);
      if (n >= 1e12) {
        return `Rp ${(n / 1e12).toFixed(2)} Triliun`;
      } else if (n >= 1e9) {
        return `Rp ${(n / 1e9).toFixed(2)} Miliar`;
      }
      return formatIDR(n);
    }

    function renderDailyChangeBadge(changeIdr, changePct) {
      const isUp = changeIdr > 0;
      const isDown = changeIdr < 0;

      if (isUp) {
        return `
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
            <svg class="w-3 h-3 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 15l7-7 7 7"/></svg>
            +${changePct.toFixed(2)}% (+${formatIDR(changeIdr)})
          </span>
        `;
      } else if (isDown) {
        return `
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
            <svg class="w-3 h-3 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"/></svg>
            ${changePct.toFixed(2)}% (${formatIDR(changeIdr)})
          </span>
        `;
      } else {
        return `
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-bold bg-gray-100 text-gray-600 border border-gray-200">
            0.00% (Rp 0)
          </span>
        `;
      }
    }

    async function loadStockCatalog() {
      const search = document.getElementById('stock-search-input').value.trim();
      const sortVal = document.getElementById('stock-sort-select').value;
      const [sortField, sortOrder] = sortVal.split(':');

      let url = `${API_BASE}/api/stocks?sort=${sortField}&order=${sortOrder}`;
      if (selectedSector && selectedSector !== 'all') {
        url += `&sector=${encodeURIComponent(selectedSector)}`;
      }
      if (search) {
        url += `&search=${encodeURIComponent(search)}`;
      }

      try {
        const res = await fetch(url);
        const data = await res.json();

        if (!res.ok) throw new Error(data.message);

        allStocks = data.stocks || [];
        allSectors = data.sectors || [];

        renderSectorChips();
        renderStockGrid();

        document.getElementById('stock-count-badge').innerText = `${allStocks.length} Saham Ditemukan`;
      } catch (err) {
        console.error('Gagal memuat katalog saham:', err);
        document.getElementById('stock-grid').innerHTML = `
          <div class="col-span-full py-12 text-center text-red-600 bg-red-50 rounded-2xl border border-red-200">
            <p class="font-bold">Gagal memuat katalog saham: ${err.message}</p>
            <button onclick="loadStockCatalog()" class="mt-3 px-4 py-2 bg-red-600 text-white rounded-lg text-xs font-semibold">Coba Lagi</button>
          </div>
        `;
      }
    }

    function renderSectorChips() {
      const container = document.getElementById('sector-chips-container');
      const allActive = selectedSector === 'all';
      
      let html = `
        <button onclick="selectSector('all')" class="px-4 py-2 rounded-xl text-xs font-semibold transition-all shadow-sm ${allActive ? 'bg-emerald-600 text-white' : 'bg-white text-gray-700 hover:bg-gray-50 border border-gray-200'}">
          Semua Sektor
        </button>
      `;

      allSectors.forEach(sec => {
        const isActive = selectedSector === sec.name;
        const translatedName = translateSector(sec.name);
        html += `
          <button onclick="selectSector('${sec.name}')" class="px-4 py-2 rounded-xl text-xs font-semibold transition-all shadow-sm ${isActive ? 'bg-emerald-600 text-white' : 'bg-white text-gray-700 hover:bg-gray-50 border border-gray-200'}">
            ${translatedName}
          </button>
        `;
      });

      container.innerHTML = html;
      document.getElementById('active-filter-badge').innerText = selectedSector === 'all' ? 'Menampilkan Semua Sektor' : `Sektor: ${translateSector(selectedSector)}`;
    }

    function selectSector(sectorName) {
      selectedSector = sectorName;
      loadStockCatalog();
    }

    function handleSearchDebounced() {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        loadStockCatalog();
      }, 300);
    }

    function renderStockGrid() {
      const grid = document.getElementById('stock-grid');
      grid.innerHTML = '';

      if (allStocks.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full py-16 text-center text-gray-500 bg-white rounded-2xl border border-gray-200">
            <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p class="text-base font-semibold text-gray-800">Tidak ada saham yang sesuai pencarian</p>
            <p class="text-xs text-gray-500 mt-1">Coba gunakan kata kunci atau pilih sektor industri lain.</p>
          </div>
        `;
        return;
      }

      allStocks.forEach(stock => {
        const sectorRaw = stock.sector ? stock.sector.name : 'Umum';
        const sectorName = translateSector(sectorRaw);
        const price = stock.current_price || stock.last_price;
        const changeIdr = stock.daily_change_idr || 0;
        const changePct = stock.daily_change_percent || 0;

        const per = stock.per ? `${stock.per}x` : '-';
        const pbv = stock.pbv ? `${stock.pbv}x` : '-';
        const divYield = stock.dividend_yield ? `${stock.dividend_yield}%` : '0%';
        const roe = stock.roe ? `${stock.roe}%` : '-';

        grid.innerHTML += `
          <div onclick="openStockModal('${stock.ticker}')" class="bg-white rounded-2xl border border-gray-200 p-5 shadow-sm hover:shadow-md hover:border-emerald-300 transition-all cursor-pointer flex flex-col justify-between group">
            <div class="space-y-3">
              <div class="flex items-start justify-between">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-lg font-black text-gray-900 group-hover:text-emerald-600 transition-colors">${stock.ticker}</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">${sectorName}</span>
                  </div>
                  <p class="text-xs text-gray-500 line-clamp-1 font-medium mt-0.5">${stock.company_name}</p>
                </div>
                <div class="w-8 h-8 rounded-lg bg-gray-50 text-gray-400 group-hover:bg-emerald-50 group-hover:text-emerald-600 flex items-center justify-center transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </div>
              </div>

              <!-- Tampilan Harga Realtime & Perubahan Hari Ini -->
              <div class="bg-gray-50/80 rounded-xl p-3 border border-gray-100 space-y-1">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Harga Realtime</span>
                  <span class="text-[10px] font-medium text-gray-400">Hari Ini</span>
                </div>
                <div class="flex items-baseline justify-between gap-2">
                  <span class="text-xl font-black text-gray-900">${formatIDR(price)}</span>
                  ${renderDailyChangeBadge(changeIdr, changePct)}
                </div>
              </div>

              <!-- Metrik Valuasi Utama -->
              <div class="grid grid-cols-2 gap-2 text-xs pt-1">
                <div class="bg-gray-50 p-2 rounded-lg">
                  <span class="text-gray-400 block text-[10px]">Market Cap</span>
                  <span class="font-bold text-gray-800">${formatMarketCap(stock.market_cap)}</span>
                </div>
                <div class="bg-gray-50 p-2 rounded-lg">
                  <span class="text-gray-400 block text-[10px]">PER</span>
                  <span class="font-bold text-indigo-600">${per}</span>
                </div>
                <div class="bg-gray-50 p-2 rounded-lg">
                  <span class="text-gray-400 block text-[10px]">PBV</span>
                  <span class="font-bold text-blue-600">${pbv}</span>
                </div>
                <div class="bg-gray-50 p-2 rounded-lg">
                  <span class="text-gray-400 block text-[10px]">Div Yield</span>
                  <span class="font-bold text-emerald-600">${divYield}</span>
                </div>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-emerald-600 font-semibold group-hover:translate-x-0.5 transition-transform">
              <span>Buka Detail & Chart Live</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </div>
          </div>
        `;
      });
    }

    async function openStockModal(ticker) {
      const modal = document.getElementById('stock-detail-modal');
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');

      const stock = allStocks.find(s => s.ticker.toUpperCase() === ticker.toUpperCase());
      if (!stock) return;

      const sectorRaw = stock.sector ? stock.sector.name : 'Umum';
      const sectorName = translateSector(sectorRaw);
      const sectorDesc = stock.sector && stock.sector.description ? stock.sector.description : 'Sektor industri yang terdaftar di Bursa Efek Indonesia.';
      const price = stock.current_price || stock.last_price;
      const prevClose = stock.previous_close || price;
      const changeIdr = stock.daily_change_idr || 0;
      const changePct = stock.daily_change_percent || 0;
      const dayHigh = stock.day_high || price;
      const dayLow = stock.day_low || price;

      document.getElementById('modal-ticker').innerText = stock.ticker;
      document.getElementById('modal-ticker-icon').innerText = stock.ticker;
      document.getElementById('modal-company-name').innerText = stock.company_name;
      document.getElementById('modal-sector-badge').innerText = sectorName;
      document.getElementById('modal-price').innerText = formatIDR(price);
      document.getElementById('modal-daily-change-badge').innerHTML = renderDailyChangeBadge(changeIdr, changePct);

      document.getElementById('modal-prev-close').innerText = formatIDR(prevClose);
      document.getElementById('modal-day-high').innerText = formatIDR(dayHigh);
      document.getElementById('modal-day-low').innerText = formatIDR(dayLow);

      const changeSign = changeIdr >= 0 ? '+' : '';
      const changeColor = changeIdr > 0 ? 'text-emerald-600' : (changeIdr < 0 ? 'text-rose-600' : 'text-gray-600');
      document.getElementById('modal-daily-change-sub').className = `font-bold text-sm ${changeColor}`;
      document.getElementById('modal-daily-change-sub').innerText = `${changeSign}${changePct.toFixed(2)}% (${changeSign}${formatIDR(changeIdr)})`;

      document.getElementById('modal-market-cap').innerText = formatMarketCap(stock.market_cap);
      document.getElementById('modal-per').innerText = stock.per ? `${stock.per}x` : '-';
      document.getElementById('modal-pbv').innerText = stock.pbv ? `${stock.pbv}x` : '-';
      document.getElementById('modal-div-yield').innerText = stock.dividend_yield ? `${stock.dividend_yield}%` : '0%';
      document.getElementById('modal-roe').innerText = stock.roe ? `${stock.roe}%` : '-';
      document.getElementById('modal-der').innerText = stock.debt_to_equity ? `${stock.debt_to_equity}x` : '-';
      document.getElementById('modal-rev-growth').innerText = stock.revenue_growth ? `${stock.revenue_growth}%` : '-';
      document.getElementById('modal-ticker-code').innerText = `IDX:${stock.ticker}`;
      document.getElementById('modal-sector-desc').innerText = `Perusahaan ${stock.company_name} bergerak dalam sektor industri ${sectorName}. ${sectorDesc}`;

      // Load TradingView Chart
      loadModalChart(`IDX:${stock.ticker}`);
    }

    function closeStockModal() {
      const modal = document.getElementById('stock-detail-modal');
      modal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }

    function loadModalChart(symbol) {
      const container = document.getElementById('modal-chart-container');
      container.innerHTML = ''; // clear previous

      if (typeof TradingView !== 'undefined') {
        new TradingView.widget({
          "autosize": true,
          "symbol": symbol,
          "interval": "D",
          "timezone": "Asia/Jakarta",
          "theme": "light",
          "style": "1",
          "locale": "id",
          "enable_publishing": false,
          "backgroundColor": "#ffffff",
          "gridColor": "#f3f4f6",
          "hide_top_toolbar": false,
          "hide_legend": false,
          "save_image": false,
          "container_id": "modal-chart-container"
        });
      }
    }

    // Tutup modal jika menekan tombol Escape pada keyboard
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeStockModal();
    });

    window.onload = () => {
      loadStockCatalog();
    };
  </script>
</body>
</html>
