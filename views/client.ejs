<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Portfolio Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="h-full text-gray-800 font-sans antialiased flex flex-col">

  <%- include('partials/headerClient') %>

  <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex justify-center">
    <div class="w-full space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-gray-200 pb-5 gap-4">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-gray-900">Dashboard Portofolio Anda</h2>
          <p class="text-sm text-gray-500 mt-1">Ringkasan saldo kas, kepemilikan saham, pergerakan pasar realtime, dan laba/rugi (PnL)</p>
        </div>
        <button onclick="loadClientData()" class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition-colors">
          <svg class="mr-2 h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          Refresh Data
        </button>
      </div>
      
      <!-- Metrics Cards (4 Columns) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- 1. Sisa Saldo Kas -->
        <div class="bg-white p-5 border border-gray-200 rounded-xl shadow-sm">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Sisa Saldo Kas Tunai</span>
          <div id="stat-client-balance" class="text-2xl font-extrabold text-green-600 mt-2">Rp 0</div>
          <p class="text-xs text-gray-400 mt-1">Saldo kas yang siap digunakan</p>
        </div>

        <!-- 2. Nilai Pasar Terkini -->
        <div class="bg-white p-5 border border-gray-200 rounded-xl shadow-sm">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Nilai Pasar Saham</span>
          <div id="stat-client-current-value" class="text-2xl font-extrabold text-blue-600 mt-2">Rp 0</div>
          <p id="stat-client-invested" class="text-xs text-gray-400 mt-1">Modal Beli: Rp 0</p>
        </div>

        <!-- 3. Total Laba / Rugi (PnL) -->
        <div class="bg-white p-5 border border-gray-200 rounded-xl shadow-sm">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Laba / Rugi (PnL)</span>
          <div id="stat-client-pnl-idr" class="text-2xl font-extrabold text-gray-900 mt-2">Rp 0</div>
          <p id="stat-client-pnl-percent" class="text-xs font-semibold text-gray-500 mt-1">0.00%</p>
        </div>

        <!-- 4. Total Nilai Aset (NAV) -->
        <div class="bg-white p-5 border border-gray-200 rounded-xl shadow-sm">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Nilai Aset (NAV)</span>
          <div id="stat-client-nav" class="text-2xl font-extrabold text-indigo-700 mt-2">Rp 0</div>
          <p id="stat-client-deposit-sub" class="text-xs text-gray-400 mt-1">Deposit: Rp 0 | Tarik: Rp 0</p>
        </div>
      </div>

      <!-- Real Time Chart -->
      <div class="bg-white p-6 border border-gray-200 rounded-xl shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Grafik Pergerakan Harga Saham (TradingView)</h3>
        <div class="flex gap-2 mb-4">
          <input type="text" id="chart-ticker-input" placeholder="Contoh: IDX:BBCA" value="IDX:BBCA" class="px-3 py-2 border border-gray-300 rounded-lg text-sm uppercase flex-grow max-w-xs focus:ring-green-500 focus:border-green-500">
          <button onclick="loadChart()" class="px-5 py-2 bg-gray-800 text-white rounded-lg text-sm font-medium hover:bg-gray-900 transition-colors">Muat Ulang</button>
        </div>
        <!-- TradingView Widget Container -->
        <div id="tradingview-widget-container" class="w-full h-[400px] border border-gray-100 rounded-lg overflow-hidden"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Portfolio Table -->
        <div class="bg-white p-6 border border-gray-200 rounded-xl shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Posisi Saham Dimiliki</h3>
            <span id="client-holdings-badge" class="text-xs font-semibold px-2.5 py-1 bg-blue-50 text-blue-700 rounded-full">0 Saham</span>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Ticker</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Harga Beli</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Harga Pasar</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Lot</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Laba/Rugi</th>
                </tr>
              </thead>
              <tbody id="portfolio-list" class="bg-white divide-y divide-gray-200">
                <!-- JS injected -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Deposits & Withdrawals Table -->
        <div class="bg-white p-6 border border-gray-200 rounded-xl shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Riwayat Mutasi Dana Kas</h3>
            <span id="client-mutasi-badge" class="text-xs font-semibold px-2.5 py-1 bg-gray-100 text-gray-700 rounded-full">0 Transaksi</span>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Tanggal</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Jenis</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Nominal</th>
                  <th scope="col" class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Catatan</th>
                </tr>
              </thead>
              <tbody id="deposit-list" class="bg-white divide-y divide-gray-200">
                <!-- JS injected -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </main>

  <script>
    const API_BASE = window.location.origin;

    window.onload = () => {
      loadClientData();
      loadChart(); // Load default chart
    };

    function formatNumber(num) {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(num || 0);
    }

    function formatDate(dateStr) {
      if (!dateStr) return '-';
      return new Date(dateStr).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    // Chart Loading logic
    function loadChart() {
      const container = document.getElementById('tradingview-widget-container');
      container.innerHTML = ''; // clear existing
      const ticker = document.getElementById('chart-ticker-input').value || 'IDX:BBCA';

      const script = document.createElement('script');
      script.type = 'text/javascript';
      script.src = "https://s3.tradingview.com/tv.js";
      script.onload = () => {
        new TradingView.widget({
          "autosize": true,
          "symbol": ticker,
          "interval": "D",
          "timezone": "Asia/Jakarta",
          "theme": "light",
          "style": "1",
          "locale": "id",
          "enable_publishing": false,
          "backgroundColor": "#ffffff",
          "gridColor": "#f3f4f6",
          "hide_top_toolbar": false,
          "hide_legend": false,
          "save_image": false,
          "container_id": "tradingview-widget-container"
        });
      };
      document.head.appendChild(script);
    }

    async function loadClientData() {
      const token = localStorage.getItem('portfolio_token');
      if (!token) return;

      try {
        const portRes = await fetch(API_BASE + '/api/portfolio/my', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const portData = await portRes.json();
        
        if (portData.summary) {
          const s = portData.summary;
          document.getElementById('stat-client-balance').innerText = formatNumber(s.cash_balance);
          document.getElementById('stat-client-current-value').innerText = formatNumber(s.total_current_value);
          document.getElementById('stat-client-invested').innerText = `Modal Beli: ${formatNumber(s.total_invested)}`;

          const isProfit = s.total_pnl_idr >= 0;
          const sign = isProfit ? '+' : '';
          const pnlIdrEl = document.getElementById('stat-client-pnl-idr');
          const pnlPctEl = document.getElementById('stat-client-pnl-percent');

          pnlIdrEl.innerText = `${sign}${formatNumber(s.total_pnl_idr)}`;
          pnlIdrEl.className = `text-2xl font-extrabold mt-2 ${isProfit ? 'text-green-600' : 'text-red-600'}`;
          pnlPctEl.innerText = `${sign}${s.total_pnl_percent.toFixed(2)}% dari modal`;
          pnlPctEl.className = `text-xs font-semibold mt-1 ${isProfit ? 'text-green-600' : 'text-red-600'}`;

          document.getElementById('stat-client-nav').innerText = formatNumber(s.net_asset_value);
          document.getElementById('stat-client-deposit-sub').innerText = `Deposit: ${formatNumber(s.total_deposit)} | Tarik: ${formatNumber(s.total_withdrawal || 0)}`;
        }

        const pList = document.getElementById('portfolio-list');
        pList.innerHTML = '';
        const holdings = portData.portfolio || [];
        document.getElementById('client-holdings-badge').innerText = `${holdings.length} Saham`;

        if (holdings.length > 0) {
          holdings.forEach(p => {
            const isProfit = p.pnl_idr >= 0;
            const sign = isProfit ? '+' : '';
            const pnlBadge = isProfit ? 'text-green-700 bg-green-50 border-green-200' : 'text-red-700 bg-red-50 border-red-200';

            pList.innerHTML += `
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-3 py-3 whitespace-nowrap text-sm font-extrabold text-blue-600">${p.ticker}</td>
                <td class="px-3 py-3 whitespace-nowrap text-xs text-gray-600">${formatNumber(p.buy_price)}</td>
                <td class="px-3 py-3 whitespace-nowrap text-xs font-bold text-gray-900">${formatNumber(p.current_price || p.buy_price)}</td>
                <td class="px-3 py-3 whitespace-nowrap text-xs text-gray-700 font-medium">${p.quantity} Lot</td>
                <td class="px-3 py-3 whitespace-nowrap text-xs">
                  <span class="inline-flex items-center px-2 py-0.5 rounded border font-bold ${pnlBadge}">
                    ${sign}${p.pnl_percent.toFixed(2)}%
                  </span>
                </td>
              </tr>
            `;
          });
        } else {
          pList.innerHTML = '<tr><td colspan="5" class="px-4 py-6 text-center text-sm text-gray-500">Belum ada posisi saham.</td></tr>';
        }

        const depRes = await fetch(API_BASE + '/api/deposits/my', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const depData = await depRes.json();
        const dList = document.getElementById('deposit-list');
        dList.innerHTML = '';
        const deposits = depData.deposits || [];
        document.getElementById('client-mutasi-badge').innerText = `${deposits.length} Transaksi`;

        if (deposits.length > 0) {
          deposits.forEach(d => {
            const isWithdraw = d.type === 'withdrawal';
            const typeBadge = isWithdraw 
              ? '<span class="px-2 py-0.5 rounded text-xs font-semibold bg-red-100 text-red-700">Tarik</span>'
              : '<span class="px-2 py-0.5 rounded text-xs font-semibold bg-green-100 text-green-700">Setor</span>';
            const amountColor = isWithdraw ? 'text-red-600' : 'text-green-600';
            const amountSign = isWithdraw ? '-' : '+';

            dList.innerHTML += `
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-3 py-3 whitespace-nowrap text-xs text-gray-500">${formatDate(d.date)}</td>
                <td class="px-3 py-3 whitespace-nowrap text-xs">${typeBadge}</td>
                <td class="px-3 py-3 whitespace-nowrap text-xs font-bold ${amountColor}">${amountSign} ${formatNumber(d.amount)}</td>
                <td class="px-3 py-3 whitespace-nowrap text-xs text-gray-600">${d.notes || '-'}</td>
              </tr>
            `;
          });
        } else {
          dList.innerHTML = '<tr><td colspan="4" class="px-4 py-6 text-center text-sm text-gray-500">Belum ada riwayat mutasi dana kas.</td></tr>';
        }

      } catch (err) {
        console.error(err);
      }
    }
  </script>
</body>
</html>
