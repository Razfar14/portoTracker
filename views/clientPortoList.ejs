<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Portfolio - Client Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="h-full text-gray-800 font-sans antialiased flex flex-col">

  <%- include('partials/headerClient') %>

  <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex justify-center">
    <div class="w-full space-y-8">
      <div class="flex items-center justify-between border-b border-gray-200 pb-5">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900">Rincian Portofolio Saham Anda</h2>
      </div>

      <div class="bg-white p-6 border border-gray-200 rounded-xl shadow-sm">
        <div class="flex justify-between items-center mb-6">
          <h3 class="text-lg font-medium text-gray-900">Managed Stocks Overview</h3>
          <button onclick="loadClientData()" class="text-sm font-medium text-gray-500 hover:text-gray-900 flex items-center">
            <svg class="mr-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            Refresh Data
          </button>
        </div>
        
        <div class="overflow-hidden ring-1 ring-black ring-opacity-5 rounded-lg">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Tanggal Pembelian</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Ticker</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Harga Beli</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Kuantitas (Lot)</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Total Nilai Beli</th>
              </tr>
            </thead>
            <tbody id="portfolio-list" class="divide-y divide-gray-200 bg-white">
              <!-- JS Injected -->
              <tr>
                <td colspan="5" class="px-3 py-8 text-center text-sm text-gray-500">Loading portfolio data...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
  
  <script>
    const API_BASE = window.location.origin;
    let jwtToken = localStorage.getItem('portfolio_token');
    
    function logout() {
      localStorage.removeItem('portfolio_token');
      localStorage.removeItem('portfolio_user');
      window.location.href = '/';
    }

    function formatNumber(num) {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' }).format(num);
    }
    
    function formatDate(dateStr) {
      return new Date(dateStr).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    async function loadClientData() {
      if (!jwtToken) return;
      try {
        const portRes = await fetch(API_BASE + '/api/portfolio/my', {
          headers: { 'Authorization': `Bearer ${jwtToken}` }
        });
        const portData = await portRes.json();
        const pList = document.getElementById('portfolio-list');
        pList.innerHTML = '';
        if (portData.portfolio && portData.portfolio.length > 0) {
          portData.portfolio.forEach(p => {
            const total = p.buy_price * p.quantity * 100; // 1 lot = 100 lembar
            pList.innerHTML += `
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-gray-500 sm:pl-6">${formatDate(p.transaction_date)}</td>
                <td class="whitespace-nowrap px-3 py-4 text-sm font-bold text-blue-600">${p.ticker}</td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900">${formatNumber(p.buy_price)}</td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">${p.quantity}</td>
                <td class="whitespace-nowrap px-3 py-4 text-sm font-medium text-gray-900">${formatNumber(total)}</td>
              </tr>
            `;
          });
        } else {
          pList.innerHTML = '<tr><td colspan="5" class="px-3 py-8 text-center text-sm text-gray-500">Belum ada data saham.</td></tr>';
        }
      } catch (err) {
        console.error(err);
      }
    }

    window.onload = () => {
      loadClientData();
    };
  </script>
</body>
</html>